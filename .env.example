# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Database user
POSTGRES_USER=edu_user
# Database password
POSTGRES_PASSWORD=changeme
# Database name
POSTGRES_DB=edu_db
# Full SQLAlchemy DSN (used by the backend directly)
POSTGRES_URL=postgresql://edu_user:changeme@localhost:5433/edu_db

# ── Redis (Celery broker + backend) ────────────────────────────────────────────
# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# ── MinIO (object storage for raw files and converted markdown) ────────────────
# MinIO endpoint — use localhost:9000 for local dev, minio:9000 inside Docker
MINIO_ENDPOINT=localhost:9000
# MinIO admin user
MINIO_ROOT_USER=minioadmin
# MinIO admin password
MINIO_ROOT_PASSWORD=changeme
# Bucket for raw uploaded files
MINIO_BUCKET_ORIGINALS=originals
# Bucket for converted Markdown files
MINIO_BUCKET_MARKDOWN=markdown

# ── Qdrant (vector database) ───────────────────────────────────────────────────
# Qdrant REST endpoint — use http://localhost:6333 locally, http://qdrant:6333 in Docker
QDRANT_URL=http://localhost:6333
# Qdrant collection name for document chunks
QDRANT_COLLECTION=edu_collection

# ── Neo4j (knowledge graph) ────────────────────────────────────────────────────
# Neo4j Bolt URI — use bolt://localhost:7687 locally, bolt://neo4j:7687 in Docker
NEO4J_URI=bolt://localhost:7687
# Neo4j username (default: neo4j)
NEO4J_USER=neo4j
# Neo4j password
NEO4J_PASSWORD=changeme

# ── LLM Providers ──────────────────────────────────────────────────────────────
# NVIDIA NIM — default provider (build.nvidia.com, 1000 free credits/day, accepts Gmail)
NIM_API_KEY=your_nim_api_key_here

# OpenRouter — free tier, no credit card required (openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq — requires org/uni email (console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Together AI — $25 free credit (api.together.xyz)
TOGETHER_API_KEY=your_together_api_key_here

# Anthropic Claude — optional in dev, used in production
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — optional in dev, used in production
OPENAI_API_KEY=your_openai_api_key_here

# ── Ollama (local / vast.ai GPU server) ────────────────────────────────────────
# Ollama API host — use http://ollama:11434 in Docker, http://localhost:11434 locally
OLLAMA_HOST=http://ollama:11434

# VLM model for image/figure description during PDF ingestion
VLM_MODEL=moondream

# Set to false to skip VLM image enrichment during development (speeds up ingestion)
VLM_ENRICHMENT_ENABLED=true

# ── GPU / Device configuration ─────────────────────────────────────────────────
# Device for BGE-M3 embedding model: cpu | cuda
EMBEDDING_DEVICE=cpu

# Device for Docling PDF accelerator: cpu | cuda
DOCLING_DEVICE=cpu

# ── Dataset generation (scripts/generate_dataset.py) ──────────────────────────
# LLM provider for QA dataset generation: nim | openrouter | groq | together | ollama
DATASET_LLM_PROVIDER=nim

# Ollama model name — only used when DATASET_LLM_PROVIDER=ollama
DATASET_LLM_MODEL=qwen3:14b

# Ollama base URL — only used when DATASET_LLM_PROVIDER=ollama
DATASET_LLM_BASE_URL=http://localhost:11434/v1
